rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() {
      return request.auth != null;
    }

    function usuarioAtual() {
      return get(
        /databases/$(database)/documents/usuarios/$(request.auth.uid)
      ).data;
    }

    function usuarioAtivo() {
      return autenticado()
        && usuarioAtual().ativo != false;
    }

    function admin() {
      return usuarioAtivo()
        && usuarioAtual().tipo in ["admin", "super_admin"];
    }

    function superAdmin() {
      return usuarioAtivo()
        && usuarioAtual().tipo == "super_admin";
    }

    match /usuarios/{usuarioId} {
      allow read: if usuarioAtivo()
        && (request.auth.uid == usuarioId || admin());

      allow create: if admin()
        && request.resource.data.tipo == "promotor";

      allow create: if superAdmin()
        && request.resource.data.tipo == "admin";

      allow update: if usuarioAtivo()
        && request.auth.uid == usuarioId
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "nome",
            "email",
            "primeiroAcesso",
            "atualizadoEm"
          ]);

      allow update: if admin()
        && resource.data.tipo == "promotor"
        && request.resource.data.tipo == "promotor"
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "lojasIds",
            "ativo",
            "atualizadoEm"
          ]);

      allow update: if superAdmin()
        && resource.data.tipo == "admin"
        && request.resource.data.tipo == "admin"
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "ativo",
            "atualizadoEm"
          ]);

      allow delete: if admin()
        && resource.data.tipo == "promotor";
    }

    match /lojas/{lojaId} {
      allow read: if usuarioAtivo();
      allow create, update, delete: if admin();
    }

    match /categorias_foto/{categoriaId} {
      allow read: if usuarioAtivo();

      function categoriaValida() {
        return request.resource.data.keys().hasOnly([
            "nome", "ativa", "atualizadoPor", "atualizadoEm"
          ])
          && request.resource.data.nome is string
          && request.resource.data.nome.size() >= 2
          && request.resource.data.nome.size() <= 60
          && request.resource.data.ativa is bool
          && request.resource.data.atualizadoPor == request.auth.uid
          && request.resource.data.atualizadoEm == request.time;
      }

      allow create: if admin() && categoriaValida();
      allow update: if admin() && categoriaValida()
        && request.resource.data.nome == resource.data.nome;
      allow delete: if false;
    }

    function nomeAdministrador() {
      let nome = usuarioAtual().get("nome", "Administrador");
      return nome is string ? nome : "Administrador";
    }

    match /produtos/{produtoId} {
      allow read: if usuarioAtivo();
      allow create, update, delete: if admin();
    }

    match /fotos/{fotoId} {
      function avaliacaoRegistrada() {
        let nova = request.resource.data;
        let registro = getAfter(
          /databases/$(database)/documents/fotos/$(fotoId)/avaliacoes/$(nova.ultimaAvaliacaoId)
        ).data;
        return nova.avaliadaPorId == request.auth.uid
          && nova.avaliadaPorNome == nomeAdministrador()
          && nova.avaliadaEm == request.time
          && registro.criadoEm == request.time
          && registro.adminId == request.auth.uid
          && registro.adminNome == nova.avaliadaPorNome
          && registro.status == nova.status
          && registro.comentario == nova.comentarioAdmin;
      }

      allow read: if admin()
        || (
          usuarioAtivo()
          && resource.data.promotorId == request.auth.uid
        );

      allow create: if usuarioAtivo()
        && usuarioAtual().tipo == "promotor"
        && request.resource.data.promotorId == request.auth.uid
        && request.resource.data.status == "pendente"
        && !request.resource.data.keys().hasAny([
          "avaliadaEm", "avaliadaPorId", "avaliadaPorNome", "ultimaAvaliacaoId"
        ]);

      allow update: if usuarioAtivo()
        && usuarioAtual().tipo == "promotor"
        && resource.data.promotorId == request.auth.uid
        && request.resource.data.promotorId == request.auth.uid
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "naLixeira",
            "excluidaEm",
            "excluidaPor",
            "restauradaEm"
          ])
        && (
          request.resource.data.excluidaPor == request.auth.uid
          || request.resource.data.excluidaPor == null
        );

      allow update: if admin() && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          "status", "comentarioAdmin", "avaliadaEm", "avaliadaPorId",
          "avaliadaPorNome", "ultimaAvaliacaoId"
        ]) || avaliacaoRegistrada()
      );
      allow delete: if admin();

      match /avaliacoes/{avaliacaoId} {
        allow read: if admin();
        allow update, delete: if false;
        allow create: if admin()
          && request.resource.data.keys().hasOnly([
            "statusAnterior", "status", "comentario", "adminId", "adminNome", "criadoEm"
          ])
          && request.resource.data.status in ["aprovada", "refazer", "rejeitada"]
          && request.resource.data.comentario is string
          && request.resource.data.adminId == request.auth.uid
          && request.resource.data.adminNome == nomeAdministrador()
          && request.resource.data.criadoEm == request.time
          && request.resource.data.statusAnterior == get(
            /databases/$(database)/documents/fotos/$(fotoId)
          ).data.get("status", "pendente")
          && getAfter(/databases/$(database)/documents/fotos/$(fotoId)).data.ultimaAvaliacaoId == avaliacaoId
          && getAfter(/databases/$(database)/documents/fotos/$(fotoId)).data.status == request.resource.data.status
          && getAfter(/databases/$(database)/documents/fotos/$(fotoId)).data.comentarioAdmin == request.resource.data.comentario
          && getAfter(/databases/$(database)/documents/fotos/$(fotoId)).data.avaliadaEm == request.time;
      }
    }

    match /visitas/{visitaId} {
      allow read: if admin()
        || (
          usuarioAtivo()
          && resource.data.promotorId == request.auth.uid
        );

      allow create: if usuarioAtivo()
        && usuarioAtual().tipo == "promotor"
        && request.resource.data.promotorId == request.auth.uid
        && request.resource.data.status == "pendente";

      allow update, delete: if admin();
    }

    match /notificacoes/{notificacaoId} {
      allow create: if admin();

      allow read: if usuarioAtivo()
        && resource.data.destinatarioId == request.auth.uid;

      allow update: if usuarioAtivo()
        && resource.data.destinatarioId == request.auth.uid
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "lida",
            "lidaEm"
          ]);

      allow delete: if admin();
    }

    match /ocorrencias_estoque/{ocorrenciaId} {
      allow read: if admin()
        || (
          usuarioAtivo()
          && resource.data.promotorId == request.auth.uid
        );

      allow create: if usuarioAtivo()
        && usuarioAtual().tipo == "promotor"
        && request.resource.data.promotorId == request.auth.uid
        && request.resource.data.tipo in ["estoque", "avaria"];

      allow update, delete: if admin();
    }

    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
